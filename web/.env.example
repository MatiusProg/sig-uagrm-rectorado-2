# Copiar a .env.local y completar con los datos del proyecto Supabase *dev*
# (Supabase → Project Settings → API). La anon key es pública por diseño:
# la seguridad la dan las políticas RLS de la base, no ocultar esta clave.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
